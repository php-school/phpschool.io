{
  "name": "php-school/website",
  "description": "PHP School Website",
  "homepage": "https://www.phpschool.io",
  "license": "MIT",
  "authors": [
    {
      "name": "Aydin Hassan",
      "email": "aydin@hotmail.co.uk"
    }
  ],
  "require": {
    "php": "^8.5",
    "slim/slim": "^4.15",
    "monolog/monolog": "^2.10",
    "php-di/slim-bridge": "^3.4",
    "psr/cache": "^3.0",
    "symfony/cache": "^7.4",
    "predis/predis": "^3.0",
    "doctrine/orm": "^3.0",
    "ramsey/uuid-doctrine": "^2.1",
    "knplabs/github-api": "^3.16",
    "jenssegers/agent": "^2.3",
    "sendgrid/sendgrid": "^8.1",
    "vlucas/phpdotenv": "^5.6",
    "mnapoli/front-yaml": "^1.8",
    "laminas/laminas-inputfilter": "^2.35",
    "laminas/laminas-uri": "^2.14",
    "laminas/laminas-authentication": "^2.19",
    "laminas/laminas-session": "^2.27",
    "symfony/finder": "^7.4",
    "laminas/laminas-filter": "^2.42",
    "laminas/laminas-servicemanager": "^3.24",
    "guzzlehttp/guzzle": "^7.10 || ^8.0",
    "http-interop/http-factory-guzzle": "^1.2",
    "akrabat/ip-address-middleware": "^2.6",
    "ext-json": "*",
    "illuminate/collections": "^13.0",
    "psr/log": "^1.1",
    "php-school/php-workshop": "dev-master",
    "php-school/learn-you-php": "dev-workshop-rewrite",
    "php-school/php8-appreciate": "dev-workshop-rewrite",
    "league/oauth2-github": "^3.1",
    "symfony/string": "^7.4",
    "symfony/translation-contracts": "^3.7",
    "ahinkle/packagist-latest-version": "^2.1",
    "symfony/rate-limiter": "^7.4",
    "jimtools/jwt-auth": "^3.0",
    "symfony/var-exporter": "^7.4",
    "mnapoli/silly": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "PhpSchool\\Website\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpSchool\\WebsiteTest\\": "test/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "doctrine/data-fixtures": "^2.2",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.95",
    "deployer/deployer": "^7.5"
  },
  "scripts": {
    "test": [
      "@phpunit",
      "@cs"
    ],
    "phpunit": "phpunit",
    "cs": "php-cs-fixer fix --dry-run --allow-risky=yes",
    "cs:ci": "php-cs-fixer fix --dry-run --allow-risky=yes --format=checkstyle | cs2pr",
    "cs-fix": "php-cs-fixer --allow-risky=yes fix",
    "static": "phpstan --ansi analyse --level 9 src",
    "app:cc": "php bin/app clear-cache",
    "app:gen:blog": "php bin/app generate-blog",
    "app:db:validate": "php bin/app orm:validate-schema",
    "app:db:update": [
      "php bin/app orm:clear-cache:metadata",
      "php bin/app orm:schema-tool:update -f --complete"
    ]
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "php-http/discovery": true
    },
    "platform": {
    }
  }
}
