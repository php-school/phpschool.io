<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.3/phpunit.xsd">
  <coverage includeUncoveredFiles="true">
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </coverage>
  <php>
    <!-- the pinned php-workshop still has implicit nullable parameters, deprecated in PHP 8.4; drop this once it is updated -->
    <ini name="error_reporting" value="E_ALL &amp; ~E_DEPRECATED"/>
  </php>
  <testsuite name="PHP School Website Test Suite">
    <directory>./test</directory>
  </testsuite>
</phpunit>
